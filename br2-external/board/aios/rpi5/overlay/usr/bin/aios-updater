#!/bin/sh
# Actualizador OTA: consulta la ultima release estable de GitHub e instala el bundle RAUC firmado.
#   aios-updater daemon   comprueba periodicamente (lo lanza S99aios-updater)
#   aios-updater check    una comprobacion e instalacion si hay version nueva

. /etc/aios/updater.conf
. /etc/aios-release   # VERSION=x.y.z

OTA_DIR=/data/ota
ATTEMPTING="$OTA_DIR/attempting"
BLOCKED="$OTA_DIR/blocked"

log() { echo "aios-updater: $*"; logger -t aios-updater "$*" 2>/dev/null; }

# Esperar a tener hora razonable (TLS necesita un reloj correcto)
wait_for_clock() {
	while [ "$(date +%Y)" -lt 2026 ]; do sleep 10; done
}

# Si la version que intentamos instalar no es la que corre, la actualizacion fallo y hubo rollback:
# se bloquea esa version para no entrar en bucle de instalar -> fallar -> revertir.
reconcile_attempt() {
	[ -f "$ATTEMPTING" ] || return 0
	tried=$(cat "$ATTEMPTING")
	if [ "$tried" != "$VERSION" ]; then
		log "la version $tried fallo y se revirtio; queda bloqueada"
		echo "$tried" >> "$BLOCKED"
	fi
	rm -f "$ATTEMPTING"
}

is_blocked() { [ -f "$BLOCKED" ] && grep -qx "$1" "$BLOCKED"; }

# 0 si $2 es estrictamente mas nueva que $1
is_newer() {
	[ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$2" ]
}

check() {
	release=$(curl -fsS --max-time 30 -H 'Accept: application/vnd.github+json' \
		"https://api.github.com/repos/${REPO}/releases/latest") || { log "no se pudo consultar GitHub"; return 1; }

	new=$(printf '%s' "$release" | jq -r '.tag_name | ltrimstr("v")')
	url=$(printf '%s' "$release" | jq -r '[.assets[] | select(.name | endswith(".raucb"))][0].browser_download_url')

	if [ -z "$new" ] || [ "$new" = "null" ] || [ -z "$url" ] || [ "$url" = "null" ]; then
		log "la release no tiene bundle .raucb valido"
		return 1
	fi
	is_newer "$VERSION" "$new" || { log "al dia (actual $VERSION, ultima $new)"; return 0; }
	is_blocked "$new" && { log "la version $new esta bloqueada por un intento fallido"; return 0; }

	log "instalando $new desde $url"
	echo "$new" > "$ATTEMPTING"
	if rauc install "$url"; then
		log "instalada $new; reiniciando"
		sync
		reboot
	else
		log "fallo la instalacion de $new"
		rm -f "$ATTEMPTING"
		return 1
	fi
}

case "$1" in
	daemon)
		sleep "$BOOT_DELAY"
		wait_for_clock
		reconcile_attempt
		while true; do
			check
			# jitter de hasta 10 min para no sincronizar a todos los dispositivos
			sleep $((CHECK_INTERVAL + $(od -An -N2 -tu2 /dev/urandom | tr -d ' ') % 600))
		done
		;;
	check)
		wait_for_clock
		reconcile_attempt
		check
		;;
	*)
		echo "Uso: $0 {daemon|check}"
		exit 1
		;;
esac
